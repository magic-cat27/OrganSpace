# ===== OrganSpace 环境配置 =====
# 复制为 .env 后按需填写：cp .env.example .env
#
# 说明：
# 1. 「疾病模拟」模式（默认主 Demo）为确定性生理引擎，完全无需大模型 API Key；
# 2. 「智能解释 / 因果链 / 器官问答」模式需要配置下方 LLM API Key 才能使用。

# LLM 提供商（默认 deepseek；可选 anthropic）
LLM_PROVIDER=deepseek

# DeepSeek（默认提供商，与代码默认一致）
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic（可选）
ANTHROPIC_API_KEY=

# 模型与生成参数
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048

# 服务监听
HOST=0.0.0.0
PORT=8765
